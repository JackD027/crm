# Copy this file to .env (copy .env.example .env on Windows) and adjust if needed.
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/sales_crm
CLIENT_ORIGIN=http://localhost:5173
AUTH_USERNAME=owner
AUTH_PASSWORD=replace-with-a-unique-password-at-least-14-characters
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
